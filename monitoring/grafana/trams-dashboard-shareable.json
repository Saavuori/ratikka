{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "InfluxQL datasource for the InfluxDB the backend writes to",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    },
    {
      "name": "VAR_BUCKET",
      "label": "Bucket",
      "description": "INFLUX_BUCKET on the server",
      "type": "constant",
      "value": "ratikka"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": ""
    }
  ],
  "title": "HSL Trams (shareable)",
  "uid": "hsl-trams-shareable",
  "description": "Per-tram history from the ratikka backend: punctuality, headways, speed and positions. A copy without template variables, for sharing outside Grafana.",
  "tags": [
    "ratikka",
    "hsl",
    "trams"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Trams in service",
      "description": "Trams that reported a position in the last two minutes.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT count(\"lat\") FROM (SELECT last(\"lat\") AS \"lat\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"veh\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Average delay",
      "description": "Mean of every tram's current delay. Negative is early. Readings more than 30 min off schedule are left out: those are trams signed on to a journey they are not running.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT mean(\"d\") / 60 FROM (SELECT last(\"delay\") AS \"d\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"veh\") WHERE \"d\" > -1800 AND \"d\" < 1800",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Late by over 3 min",
      "description": "Readings more than 30 min off schedule are left out: those are trams signed on to a journey they are not running.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT count(\"d\") FROM (SELECT last(\"delay\") AS \"d\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"veh\") WHERE \"d\" > 180 AND \"d\" < 1800",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Early by over 1 min",
      "description": "Running early is worse than late for a rider: the tram leaves before they arrive.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT count(\"d\") FROM (SELECT last(\"delay\") AS \"d\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"veh\") WHERE \"d\" < -60 AND \"d\" > -1800",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Bunched",
      "description": "Trams running so close behind the one ahead on their line that the two arrive together.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT count(\"s\") FROM (SELECT last(\"headway_state\") AS \"s\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"veh\") WHERE \"s\" = 'bunched'",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Behind a gap",
      "description": "Trams running well behind the one ahead, leaving the stops between them waiting.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT count(\"s\") FROM (SELECT last(\"headway_state\") AS \"s\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"veh\") WHERE \"s\" = 'gap'",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "geomap",
      "title": "Where they are",
      "description": "Latest position of every tram, coloured by delay.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT last(\"lat\") AS \"lat\", last(\"lng\") AS \"lng\", last(\"delay\") / 60 AS \"delay\", last(\"speed\") * 3.6 AS \"speed\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"veh\", \"desi\"",
          "rawQuery": true,
          "resultFormat": "table",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "delay"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "speed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 60.18,
          "lon": 24.94,
          "zoom": 12
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Trams",
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lng"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 7
                },
                "color": {
                  "field": "delay"
                },
                "opacity": 0.9,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "text": {
                  "mode": "field",
                  "field": "desi"
                },
                "textConfig": {
                  "fontSize": 10,
                  "offsetX": 0,
                  "offsetY": -12,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Every tram now",
      "description": "Sorted by delay. Click a column header to re-sort.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT last(\"delay\") / 60 AS \"Delay\", last(\"speed\") * 3.6 AS \"Speed\", last(\"headway\") / 60 AS \"Behind ahead\", last(\"headway_state\") AS \"Headway\", last(\"next_stop\") AS \"Next stop\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE time > now() - 2m GROUP BY \"desi\", \"veh\", \"dir\"",
          "rawQuery": true,
          "resultFormat": "table",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Delay"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 2
                    },
                    {
                      "color": "red",
                      "value": 4
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Speed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Behind ahead"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Headway"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "bunched": {
                        "color": "red",
                        "index": 0
                      },
                      "gap": {
                        "color": "orange",
                        "index": 1
                      },
                      "regular": {
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "desi"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Line"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "veh"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tram"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dir"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Dir"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Delay",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Punctuality",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Average delay by line",
      "description": "Mean delay across every reading of the line. Positive is late. Readings more than 30 min off schedule are left out: those are trams signed on to a journey they are not running.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT mean(\"delay\") / 60 FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE $timeFilter AND \"delay\" > -1800 AND \"delay\" < 1800 GROUP BY time($__interval), \"desi\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_desi"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Average delay over the period",
      "description": "Readings more than 30 min off schedule are left out: those are trams signed on to a journey they are not running.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT mean(\"delay\") / 60 AS \"delay\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE $timeFilter AND \"delay\" > -1800 AND \"delay\" < 1800 GROUP BY \"desi\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_desi"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": -0.5
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Trams in service by line",
      "description": "Distinct trams reporting each minute.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "refId": "A",
          "query": "SELECT count(\"lat\") FROM (SELECT last(\"lat\") AS \"lat\" FROM \"${VAR_BUCKET}\".\"autogen\".\"vehicle_position\" WHERE $timeFilter GROUP BY time(1m), \"veh\", \"desi\") WHERE $timeFilter GROUP BY time(1m), \"desi\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_desi"
        }
      ],
      "fieldConfig": {
        "defaults": {
