# typescript-eslint v8 peer-dep declares typescript <6.1.0 but we run TS 7 for
# the build.  The postinstall script (scripts/link-ts6-for-eslint.cjs) sets up
# the side-by-side resolution.  legacy-peer-deps silences the peer-dep conflict
# warning from npm during install.
#
# TODO: remove once typescript-eslint ships TS 7.1+ support
# (https://github.com/typescript-eslint/typescript-eslint/issues/10940).
# Also remove typescript-6 devDependency and scripts/link-ts6-for-eslint.cjs.
legacy-peer-deps=true
